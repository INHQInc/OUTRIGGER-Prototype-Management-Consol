# Copy to .env.local and fill in. Never commit .env.local.

# --- Capture ---
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Auth ---
# Random secret that signs 365-day session cookies (e.g. `openssl rand -base64 48`)
AUTH_SECRET=
# Comma-separated emails allowed to admin-login
ADMIN_EMAILS=admin@outrigger.local
# Master secret for admin sign-in
ADMIN_LOGIN_SECRET=changeme-local-dev

# --- Hosted persistence (optional locally; required for hosted auth/bindings) ---
# Neon Postgres connection string. Absent => JSON store under .data/ (local only).
DATABASE_URL=

# --- Optimizely (experiment draft-push) ---
# Scoped service-account Personal Access Token
OPTIMIZELY_API_TOKEN=
# Prep sandbox 24138040550 (prove here first), Prod 21089662478
OPTIMIZELY_PROJECT_ID=24138040550

# --- Emailed readouts (optional; with none of these, sending is disabled and
#     the app says so rather than pretending to send) -------------------------
#
# EITHER Gmail over SMTP — the only honest way to send FROM a @gmail.com
# address, because no provider can verify a domain it doesn't control. Needs
# 2-Step Verification on the account and an APP PASSWORD (not the account
# password): https://myaccount.google.com/apppasswords
GMAIL_USER=inhqinc@gmail.com
GMAIL_APP_PASSWORD=
# Optional display name; the address itself is always the authenticated account
# because Google rewrites anything else.
REPORT_FROM_NAME="Experiment readouts"
#
# OR Resend, once a real domain is verified (better deliverability, no daily
# cap worth thinking about). Gmail wins if both are set.
RESEND_API_KEY=
REPORT_FROM_EMAIL="Experiment readouts <readouts@yourdomain.com>"
