# Copy to .env.local and fill in. Never commit .env.local.

# --- Capture ---
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Auth ---
# Random secret that signs 365-day session cookies (e.g. `openssl rand -base64 48`)
AUTH_SECRET=
# Comma-separated emails allowed to admin-login
ADMIN_EMAILS=admin@outrigger.local
# Master secret for admin sign-in
ADMIN_LOGIN_SECRET=changeme-local-dev

# --- Hosted persistence (optional locally; required for hosted auth/bindings) ---
# Neon Postgres connection string. Absent => JSON store under .data/ (local only).
DATABASE_URL=

# --- Optimizely (experiment draft-push) ---
# Scoped service-account Personal Access Token
OPTIMIZELY_API_TOKEN=
# Prep sandbox 24138040550 (prove here first), Prod 21089662478
OPTIMIZELY_PROJECT_ID=24138040550

# --- Emailed readouts (optional; with none of these, sending is disabled and
#     the app says so rather than pretending to send) -------------------------
#
# Pick ONE. Order when several are set: mailgun -> resend -> gmail. A provider
# that authenticates the sending DOMAIN outranks Gmail, which can only ever send
# as one person's personal account.
#
# Pin one explicitly (mailgun | resend | gmail). If the named one isn't fully
# configured, sending is disabled and says so — it never falls through to a
# different sender.
MAIL_PROVIDER=

# The address the readout comes from. Required for mailgun and resend.
REPORT_FROM_EMAIL="BrandGraph AI <admin@brandgraphai.com>"
# Display name for the Gmail path only (the address there is always the
# authenticated account, because Google rewrites anything else).
REPORT_FROM_NAME="Experiment readouts"

# --- Option A: Mailgun (domain sender) ---
# brandgraphai.com already authenticates through Mailgun in DNS.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=brandgraphai.com
# Only if the domain lives in Mailgun's EU region — a US key against the EU host
# returns 401 and reads exactly like a bad key.
MAILGUN_REGION=

# --- Option B: Resend (domain sender) ---
RESEND_API_KEY=

# --- Option C: Gmail over SMTP (fallback) ---
# The only honest way to send FROM a @gmail.com address. Needs 2-Step
# Verification and an APP PASSWORD, not the account password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
